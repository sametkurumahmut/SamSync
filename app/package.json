{
  "name": "samsync",
  "productName": "SamSync",
  "version": "2.1.1",
  "description": "Dosyaları ve Git değişikliklerini birden çok makineye aynı göreli yolla gönderen, karşılaştıran ve eşitleyen masaüstü uygulaması.",
  "author": "Samet Kurumahmut",
  "license": "UNLICENSED",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "web": "node scripts/web-server.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "node scripts/dist.mjs --publish never",
    "dist:win": "node scripts/dist.mjs --win --publish never",
    "dist:mac": "node scripts/dist.mjs --mac --publish never",
    "dist:linux": "node scripts/dist.mjs --linux --publish never",
    "release:folder": "node scripts/release-folder.mjs",
    "demo": "node scripts/demo-env.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "release:github": "node scripts/dist.mjs --win --publish always",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.0",
    "lucide-react": "^1.50.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.0",
    "zustand": "^5.0.8"
  }
}
